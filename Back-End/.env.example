# --- Application ---
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://sparkowater.example.com
LOG_LEVEL=info

# --- Behind AWS Application Load Balancer ---
# Tells Express to honor X-Forwarded-For / X-Forwarded-Proto from the ALB.
# Use a comma list of trusted CIDRs, or "loopback, linklocal, uniquelocal".
TRUST_PROXY=loopback, linklocal, uniquelocal

# Unique per-instance ID (ECS task ID, EC2 instance id, etc.) — appears in
# every log line so you can correlate requests with the node that served them
# when multiple replicas sit behind the ALB.
INSTANCE_ID=

# --- Database (AWS RDS MySQL/Aurora) ---
# Point DB_HOST at the RDS cluster writer endpoint so failover is transparent
# and connections route to whichever instance is currently primary.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=sparko_water
# 'true' = require SSL with verified RDS CA, 'relaxed' = SSL no verify, '' = no SSL
DB_SSL=relaxed

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=24h
RESET_TOKEN_EXPIRES_HOURS=1

# --- AWS CloudWatch Logs ---
# Leave blank to log only to stdout (which the awslogs / CloudWatch agent
# can scrape). Set both to ship logs directly from the app.
AWS_REGION=us-east-1
CLOUDWATCH_LOG_GROUP=/sparko/api
CLOUDWATCH_LOG_STREAM=
CLOUDWATCH_RETENTION_DAYS=30

# --- Square API (checkout) ---
# Get these from https://developer.squareup.com/apps
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# 'sandbox' for testing, 'production' for live
SQUARE_ENVIRONMENT=sandbox

# --- AWS Secrets Manager (production) ---
# When set, the API pulls DB + JWT + Square config from Secrets Manager at
# startup and overlays the corresponding values above. The IAM instance
# profile must grant secretsmanager:GetSecretValue on these specific ARNs.
SECRETS_DB_ARN=
SECRETS_APP_ARN=

# --- SES transactional email ---
# Verified sender address. Leave blank to log emails instead of sending.
SES_FROM=

# --- HTTPS / HSTS ---
# Set to "true" only when the site is fronted by HTTPS (ACM cert + domain).
# Default (false) skips the Strict-Transport-Security header so HTTP-only
# deployments don't poison browser caches with an HSTS pin.
ENABLE_HSTS=false
